{
  "name": "PFR Opportunity Identification",
  "version": "1.0.0",
  "description": "After each agent session, review the work done and identify any AWS service gaps, limitations, or improvement opportunities that qualify as Product Feature Requests. Research each candidate using web search and AWS documentation before documenting in PFRs.md.",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Review the work completed in this session and identify any AWS service gaps, limitations, missing capabilities, console UX friction, API gaps, or workarounds that were required. For each candidate PFR opportunity: (1) use web search and the AWS documentation MCP server to verify the gap is real and not already addressed in a recent release, (2) research existing workarounds and their limitations, (3) validate customer impact. If one or more validated PFR opportunities are found, append them to PFRs.md at the workspace root using the format defined in the pfr-tracking steering document. If PFRs.md does not exist, create it with a summary table header first. After documenting, briefly tell the user what was added."
  }
}
